rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /rides/{rideId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /annotations/{annotationId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/rides/$(rideId)).data.userId == request.auth.uid;
      }
    }

    match /studyParticipants/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /compensationClaims/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /adminNotifications/{notificationId} {
      allow create: if isSignedIn();
      allow read: if false;
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /app_version/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
