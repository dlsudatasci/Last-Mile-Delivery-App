{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "types": ["jest", "node"],
        "typeRoots": ["./types", "./node_modules/@types"],
        "paths": {
            "@/*": ["./*"],
            "@firebase/auth": ["./node_modules/@firebase/auth/dist/index.rn.d.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
    "exclude": ["node_modules", "admin-web", "dist"]
}
