# ─────────────────────────────────────────────
# Firebase Admin SDK (Service Account)
# ─────────────────────────────────────────────
# To get FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY:
# 1. Go to https://console.firebase.google.com
# 2. Select project "thesis-67"
# 3. Project Settings → Service Accounts → Generate new private key
# 4. Open the downloaded JSON and copy client_email and private_key below

FIREBASE_PROJECT_ID=thesis-67
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@thesis-67.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=thesis-67.firebasestorage.app

# ─────────────────────────────────────────────
# Admin Authentication
# ─────────────────────────────────────────────
# Comma-separated list of email addresses allowed to log in as admins
ADMIN_ALLOWED_EMAILS=your-admin-email@example.com

# Secret used to sign session cookies (generate with the command below)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_32_CHAR_SECRET

# ─────────────────────────────────────────────
# Firebase Client SDK (for admin login page)
# ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC-Mon93cqtiklnvtV_VSWIRznkNbK12fo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=thesis-67.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=thesis-67
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=thesis-67.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=512393055743
NEXT_PUBLIC_FIREBASE_APP_ID=1:512393055743:web:9516ea2c214a186312abca
